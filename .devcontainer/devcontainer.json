{
    "name": "CrewAI Development Environment",
    "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
    // sudo を追加し、さらにパスを直接指定することで確実に動かします
    "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && sudo $HOME/.cargo/bin/uv pip install crewai --system"
}
